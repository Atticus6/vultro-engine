# 引擎 id：Worker 侧的派发路由键。部署后不要再改（改了等于换一台节点）。
ENGINE_ID=off1

# 与 Worker 的 OFFLINE_ENGINE_TOKEN 同值（双向 Bearer）。
# 取值：Cloudflare Dashboard → Workers → vultro-test → Settings → Variables and Secrets。
ENGINE_TOKEN=replace-me

# Worker 基址：测试环境用 test 域；生产用 https://www.vultro.app。
WORKER_BASE_URL=https://this-is-test.vultro.app

# 并发槽位数（1–16）。每槽约 64 MiB 内存。
ENGINE_CAPACITY=2

# 取源站出口：
#   warp   —— 经 Cloudflare WARP 出网（源站只见 WARP IP；需要出站 UDP 2408）
#   relay  —— 经 Worker 转发（源站只见 Cloudflare IP；不需要额外网络条件）
#   direct —— 直连源站（会暴露宿主机 IP，建议仅调试）
EGRESS_MODE=warp

# WARP 身份持久化目录（容器内建议挂 volume）。
WARP_IDENTITY_PATH=/data/warp

# cloudflared 隧道协议：http2（TCP 7844，最稳）/ quic（UDP 7844）/ auto
TUNNEL_PROTOCOL=http2
